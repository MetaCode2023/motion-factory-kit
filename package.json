{
  "name": "motion-factory-kit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Have Claude write motion-graphics videos as code, then render them to MP4 frame-perfect. No browser, no screen recording.",
  "license": "MIT",
  "scripts": {
    "demo": "node tools/demo.mjs",
    "ugc": "node make.mjs scenes/examples/ugc-ad.html --variants",
    "gallery": "node render.mjs scenes/examples/blocks-gallery.html --sheet",
    "render": "node render.mjs",
    "examples": "node batch.mjs scenes/examples --sheet",
    "test": "node --test tests/kit.test.mjs tests/sound.test.mjs tests/batch.test.mjs tests/footage.test.mjs tests/review.test.mjs tests/mcp.test.mjs",
    "mcp": "node mcp/server.mjs",
    "overlays-demo": "python3 tools/overlay.py demo"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ffmpeg-static": "^5.2.0",
    "skia-canvas": "^4.0.0",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "playwright-core": "^1.48.0"
  },
  "bin": {
    "motion-factory-mcp": "mcp/server.mjs"
  }
}
