# Copy to .env (git-ignored) and fill in. Never commit real values. Environment variables win over this file.
# Cloudflare API token with D1 Edit + Workers R2 Storage Edit + Workers AI on the account.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# R2 S3 keys (an R2 API token, Object Read & Write on the simulation-videos bucket). See docs/SIM.md.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional: defaults to https://<account id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET=simulation-videos
D1_DATABASE=simulation
# Optional: defaults to the id in infra/cloudflare/wrangler.jsonc
D1_DATABASE_ID=
# Who you are in the job log: claude-code, codex, gemini, ...
SIM_AGENT=
